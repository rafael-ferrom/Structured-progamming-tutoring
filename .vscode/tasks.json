{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C: compilar arquivo atual",
      "type": "shell",
      "command": "gcc",
      "args": [
        "-Wall",
        "-Wextra",
        "-std=c11",
        "-g",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "options": { "cwd": "${fileDirname}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "C: compilar e executar arquivo atual",
      "type": "shell",
      "command": "${fileDirname}/${fileBasenameNoExtension}",
      "dependsOn": "C: compilar arquivo atual",
      "options": { "cwd": "${fileDirname}" },
      "problemMatcher": []
    }
  ]
}
